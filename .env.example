# Token from @BotFather
BOT_TOKEN=
# Your Telegram user ids, comma-separated (find yours via @userinfobot)
ADMIN_IDS=
# Open channel for free signals (/free posts here), e.g. -1001234567890.
# The bot must be an admin there with the right to post. Optional.
PUBLIC_CHANNEL_ID=
# Optional private channel. Leave empty: full signals go to subscribers' private chats (/signal).
CHANNEL_ID=
# Receiving address only. Never put a private key or seed phrase here.
PAYMENT_NETWORK=TRC20
PAYMENT_ADDRESS=
INVOICE_TTL_MINUTES=60
# Optional, raises TronGrid rate limits: https://www.trongrid.io
TRONGRID_API_KEY=
# A transfer this much below the invoice still counts as paid
UNDERPAY_TOLERANCE=0
# Hours of access kept after a subscription ends
GRACE_HOURS=0
POSTGRES_PASSWORD=change-me
